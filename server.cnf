[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = MX
ST = Queretaro
L = Queretaro
O = Cardenal GO
OU = TI
CN = cardenal_go.adm

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = cardenal_go.adm
DNS.2 = api.cardenal_go.adm
DNS.3 = localhost
IP.1 = 127.0.0.1
IP.2 = 192.168.100.36